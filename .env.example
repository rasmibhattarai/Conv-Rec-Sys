# OpenAI-compatible API Configuration
# Copy this file to .env and fill in your credentials

# Your API key for the OpenAI-compatible endpoint
OPENAI_API_KEY=your_api_key_here

# Base URL for the API endpoint (e.g., OpenAI, or custom inference server)
OPENAI_BASE_URL=https://your-api-endpoint.com/v1

# Model name to use for inference (e.g., gpt-4o, gpt-3.5-turbo, or custom model)
OPENAI_MODEL=your_preferred_model
